{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Keeprun",
  "identifier": "dev.keeprun.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Keeprun",
        "width": 1100,
        "height": 720,
        "minWidth": 760,
        "minHeight": 480
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' ipc: http://ipc.localhost http://127.0.0.1:* ws://127.0.0.1:*; style-src 'self' 'unsafe-inline'; img-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "msi",
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "mainBinaryName": "keeprun-desktop",
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEJENEVCRjY3RjNFNEFCRkYKUldUL3ErVHpaNzlPdlNKdnlXK1BKZ3p2ajFyVGZDNWFWN1dubkFKQlROdUx4OXZuVlJ1Wm1BanAK",
      "endpoints": [
        "https://keeprun.dev/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
